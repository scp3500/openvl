#!/usr/bin/env node
const { spawn } = require('child_process');
const path = require('path');
const fs = require('fs');

const PKG_DIR = path.join(__dirname, '..');
const MCP_JS = path.join(PKG_DIR, 'scripts', 'mcp_server.js');
const VISION_PY = path.join(PKG_DIR, 'scripts', 'vision.py');
const args = process.argv.slice(2);

function findPython() {
    if (process.env.OPENVL_PYTHON) return process.env.OPENVL_PYTHON;
    for (const name of ['python3', 'python']) {
        const r = spawn.sync(name, ['--version'], { encoding: 'utf8', timeout: 3000 });
        if (r.status === 0) return name;
    }
    return 'python';
}

function run() {
    if (args.includes('--mcp') || args[0] === 'openvl-mcp') {
        const mode = args.includes('http') ? 'http' : 'stdio';
        const proc = spawn(process.execPath, [MCP_JS], {
            stdio: ['pipe', 'pipe', 'inherit'],
            env: { ...process.env, OPENVL_MCP_MODE: mode },
            cwd: PKG_DIR
        });
        process.stdin.pipe(proc.stdin);
        proc.stdout.pipe(process.stdout);
        proc.on('exit', c => process.exit(c));
    } else {
        const py = findPython();
        const proc = spawn(py, [VISION_PY, ...args], { stdio: 'inherit' });
        proc.on('exit', c => process.exit(c));
    }
}

run();
